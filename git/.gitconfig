[include]
	path = ~/.gitconfig.local
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = false
	line-numbers = true
	syntax-theme = gruvbox-dark
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
