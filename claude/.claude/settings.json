{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git remote get-url:*)",
      "Bash(git switch main:*)",
      "Bash(git push origin HEAD:*)",
      "Bash(git push -u origin HEAD:*)",
      "Bash(git worktree:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(glab mr create:*)",
      "Bash(glab mr view:*)",
      "Bash(glab mr diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag -d:*)",
      "Bash(git merge:*)",
      "Bash(rm -rf:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Bash(glab mr merge:*)",
      "Bash(glab repo delete:*)"
    ]
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true
}
